# ---------------------------------------------------------------------------
# Secrets — never commit real credentials.
# .env.example is the tracked template and must contain placeholders only.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# API keys / service accounts
*.pem
*.key
service-account*.json
credentials.json

